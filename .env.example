# Claude API (content generation, comment triage, reply drafting)
ANTHROPIC_API_KEY=

# Where the SQLite database lives
TBS_DB_PATH=tbs_social.db

# Brand profile (voice, services, topics, compliance rules)
TBS_BRAND_FILE=brand.toml

# Platforms to connect: comma-separated from: mock, facebook, instagram, google
TBS_PLATFORMS=mock

# Meta Graph API (Facebook Page + Instagram Business account)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v21.0

# Google Business Profile (reviews, Google posts, search/maps metrics)
# OAuth client from Google Cloud + refresh token with scope
# https://www.googleapis.com/auth/business.manage. Find the IDs with:
#   python -m tbs_social google-locations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# Automation level: "approve" (every outgoing reply/post needs a human click)
# or "assist" (low-risk thank-you replies + comment likes go out automatically;
# anything sensitive still waits for a human)
TBS_AUTOMATION=approve

# Compliance: "standard" for business/marketing accounts, or "hipaa" for accounts
# that talk to patients (adds PHI flagging, redaction and patient-confirmation blocks)
TBS_COMPLIANCE=standard

# Safety caps per platform per monitoring cycle
TBS_MAX_AUTO_LIKES=20
TBS_MAX_AUTO_REPLIES=10

# Dashboard login (HTTP Basic). Required when serving beyond localhost.
TBS_DASHBOARD_USER=admin
TBS_DASHBOARD_PASSWORD=
